(ns bunken.scheme
  "bunken（文献書誌）判定コア — itonami dapp bundle（pure, :effects #{}）。

  書誌 identifier 体系と収集ジョブの判定（正本: kotoba/src/types.ts +
  collection.ts）:

  - **BunkenScheme は 9 つの閉じた集合**: ndl:bib / ndl:pid / ncid / lccn /
    oclc / isbn / doi / viaf / ark（scheme 固有の identifier は scheme の中で
    しか意味を持たない — 集合外の scheme は受けない）。
  - **MaterialType は 7 つの閉じた集合**: book / article / serial / thesis /
    manuscript / map / other。
  - CollectionJob は scheme の検証と urlPattern 必須。pending から始まり、
    **pending が無いジョブは noPendingJob**（取りこぼし防止）。

  scheme-ok: 1 = 0..8 の内（0 ndl:bib .. 8 ark）
  material-ok: 1 = 0..6 の内（0 book .. 6 other）
  job-admission の戻り: 0 = 作成可（pending）/ 1 = invalidScheme
    / 2 = urlPattern 無し
  job-pick: 1 = pending を取れる / 0 = noPendingJob

  実行 host はスカラーのみ = KIR v3 / i64/direct ABI（kernel/selfhost 両対応）。

  テストはゼロ引数 test-*、戻り 1/0:
  <amu> test aiueos/bunken_scheme.cljk"
  (:export [main scheme-ok material-ok job-admission job-pick
            test-scheme test-material test-admission test-pick
            test-fail-closed]))

(defn main [] :i64
  0)

(defn scheme-ok [code :i64] :i64
  (if (and (>= code 0) (<= code 8)) 1 0))

(defn material-ok [code :i64] :i64
  (if (and (>= code 0) (<= code 6)) 1 0))

(defn job-admission [scheme-code :i64 has-url-pattern :i64] :i64
  (if (= (scheme-ok scheme-code) 0)
    1
    (if (= has-url-pattern 1) 0 2)))

(defn job-pick [has-pending :i64] :i64
  (if (= has-pending 1) 1 0))

;; --- tests（戻り 1 = pass） ------------------------------------------------

(defn test-scheme [] :i64
  ;; 9 つの閉じた集合（ndl:bib .. ark）
  (if (= (+ (scheme-ok 0) (scheme-ok 8) (scheme-ok 9) (scheme-ok -1)) 2) 1 0))

(defn test-material [] :i64
  ;; 7 つの閉じた集合（book .. other）
  (if (= (+ (material-ok 0) (material-ok 6) (material-ok 7)) 2) 1 0))

(defn test-admission [] :i64
  (if (= (+ (job-admission 5 1) (job-admission 9 1) (job-admission 5 0)) 3) 1 0))

(defn test-pick [] :i64
  ;; pending が無ければ noPendingJob
  (if (= (+ (job-pick 1) (job-pick 0)) 1) 1 0))

(defn test-fail-closed [] :i64
  ;; 集合外の scheme / material は拒否
  (if (= (+ (scheme-ok 10) (material-ok 99) (job-admission -1 1)) 1) 1 0))
